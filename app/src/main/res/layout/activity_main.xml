<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <TextureView
        android:id="@+id/textureView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="260dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ready"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:paddingBottom="8dp" />

            <!-- Shoot steps (number of bracketed frames) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#FFFFFF"
                    android:text="Shoot steps (frames)" />
                <EditText
                    android:id="@+id/editSteps"
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:text="5"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <!-- EV stops between each step -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#FFFFFF"
                    android:text="Stops (EV) per step" />
                <EditText
                    android:id="@+id/editStops"
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:text="1.0"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <!-- Base ISO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#FFFFFF"
                    android:text="Base ISO" />
                <EditText
                    android:id="@+id/editIso"
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:text="100"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <!-- Split of EV taken from ISO vs shutter speed -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#FFFFFF"
                    android:text="ISO weight (0=shutter only, 1=ISO only)" />
                <EditText
                    android:id="@+id/editIsoWeight"
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:text="0.0"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <!-- fx: focal length lock (index into available focal lengths) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#FFFFFF"
                    android:text="fx: focal length (blank = auto)" />
                <EditText
                    android:id="@+id/editFocal"
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:hint="mm"
                    android:textColorHint="#777777"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <!-- Saturation optimization heuristic -->
            <CheckBox
                android:id="@+id/checkOptimizeSaturation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#FFFFFF"
                android:text="Optimize for saturation (fewer frames, adaptive spacing)" />

            <!-- Burst stacking mode -->
            <CheckBox
                android:id="@+id/checkBurstStacking"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#FFFFFF"
                android:text="Burst stacking (fixed exposure, minimal blur)" />

            <Button
                android:id="@+id/captureButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Capture HDR Fusion" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
